# Fast Model (Default)
FAST_PROVIDER=mercury
FAST_MODEL_URL=https://api.nousresearch.com/v1
FAST_MODEL_ID=hermes-3-70b
FAST_MODEL_KEY=***

# Reasoning Model
REASONING_PROVIDER=mercury
REASONING_URL=https://api.nousresearch.com/v1
REASONING_MODEL_ID=hermes-3-70b
REASONING_MODEL_KEY=***

# HaiMaker. Used when you pass --provider haimaker.
# Sent as Authorization: Bearer. Do not put this key in FAST_MODEL_KEY.
# HAIMAKER_API_KEY=
# HAIMAKER_BASE_URL=https://api.haimaker.ai/v1
# HAIMAKER_MODEL_ID=anthropic/claude-sonnet-5
# Optional critic model. Default is google/gemini-3.5-flash, never the writer.
# export CHECK_MODEL=
# Key ceiling is set on the HaiMaker key, not in this file.
# Use a service account key. Set max_budget, budget_duration, soft_budget
# (alert only), and a models allowlist matching the picker.
# model_max_budget is optional for expensive models.
# https://docs.haimaker.ai/docs/key_management
# https://docs.haimaker.ai/docs/service_accounts

# Tavily. Optional. Search uses keyless access when this is unset.
# Do not commit a live key. .env is gitignored.
# TAVILY_API_KEY=

# Essay store. Local CLI uses data/essays.kv when this is unset.
# Tests may set :memory: or a temp file. Leave unset on Deno Deploy so the
# attached KV is used (`DENO_DEPLOYMENT_ID` is set by the platform).
# Never put API keys in FRESH_PUBLIC_ vars.
# ESSAY_KV_PATH=
# Optional sqlite file. Default is data/flue.db locally, /tmp/flue.db on Deploy.
# FLUE_SQLITE_PATH=
