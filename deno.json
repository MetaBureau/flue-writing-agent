{
  "imports": {
    "fresh": "jsr:@fresh/core@^2.3.3",
    "fresh/runtime-client": "jsr:@fresh/core@^2.3.3/runtime-client",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@7.3.6",
    "tailwindcss": "npm:tailwindcss@^4.2.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.2.1",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.19",
    "daisyui": "npm:daisyui@^5.5.19",
    "preact": "npm:preact@^10.26.9",
    "@std/dotenv/load": "jsr:@std/dotenv@^0.225.6/load",
    "@flue/runtime": "npm:@flue/runtime@^2.0.7",
    "@flue/runtime/": "npm:/@flue/runtime@^2.0.7/",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@^0.83.0",
    "@earendil-works/pi-ai/": "npm:/@earendil-works/pi-ai@^0.83.0/",
    "valibot": "npm:valibot@^1.2.0"
  },
  "unstable": ["kv"],
  "tasks": {
    "start": "deno run --env --unstable-kv --allow-net --allow-read --allow-write --allow-env src/main.ts",
    "write": "deno run --env --unstable-kv --allow-net --allow-read --allow-write --allow-env src/main.ts",
    "dev": "deno run -A npm:vite@7.3.6",
    "build": "deno run -A npm:vite@7.3.6 build",
    "serve": "deno serve -A --unstable-kv _fresh/server.js",
    "test": "deno test --unstable-kv --allow-read --allow-write --allow-env tests/",
    "smoke": "deno run -A --unstable-kv scripts/smoke.ts",
    "ci": "deno task test && deno lint && deno task build && deno task smoke",
    "eval": "deno run --env --unstable-kv --allow-net --allow-read --allow-write --allow-env evals/run.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "ESNext", "deno.ns", "deno.unstable"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "lint": {
    "rules": { "tags": ["recommended", "fresh", "jsx"] }
  },
  "workspace": [],
  "nodeModulesDir": "auto",
  "overrides": {
    "npm:vite": "npm:vite@7.3.6",
    "npm:@tailwindcss/vite": "npm:@tailwindcss/vite@4.2.1"
  },
  "exclude": ["**/_fresh/*", "node_modules"]
}
